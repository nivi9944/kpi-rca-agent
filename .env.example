# Copy to .env (never commit .env). The agent talks to the LLM Gateway (Project 1) by default.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dev-key-1
# Model name sent to the gateway. The gateway routes by PROVIDER_ORDER, but its cache key includes this
# name, so Gemini and Ollama runs never share cached answers.
LLM_MODEL=gemini-3.6-flash
OLLAMA_MODEL=qwen2.5:7b
# Fallbacks if the gateway is down: talk to Gemini / Ollama directly
DIRECT_GEMINI=false
GEMINI_API_KEY=
DIRECT_OLLAMA=false
OLLAMA_URL=http://localhost:11434/v1
DUCKDB_PATH=data/olist.duckdb
MAX_STEPS=12
# Stay under the gateway rate limit (10-request burst, ~10/min) and Gemini free-tier limits
REQUESTS_PER_MIN=8
# Mistral presets (model names are pinned in agent/llm_client.py): mistral = mistral-small-2603,
# mistral-medium = mistral-medium-latest. The gateway limits each key to ~10 requests/min, and the Mistral
# free plan to 20,000 tokens/min, so the client waits for both.
MISTRAL_REQUESTS_PER_MIN=9
MISTRAL_TPM_BUDGET=18000
# nvidia preset (headline): the gateway limits each key to ~10 requests/min
NVIDIA_REQUESTS_PER_MIN=9
# Stop the evaluation before the estimated list-price spend in results/ passes this (USD)
BUDGET_USD=8
